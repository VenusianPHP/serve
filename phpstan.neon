parameters:
    level: 1
    paths:
        - src
        - phpstan/TraitConsumers.php
    treatPhpDocTypesAsCertain: false  # docblock types are not enforced at runtime: the guards they make look redundant stand at trust boundaries, which must stay
    tmpDir: .phpstan.cache
    ignoreErrors:
        # Laravel's factory and fluent APIs return new static() on extendable classes by design; subclasses keep the constructor contract.
        -
            identifier: new.static
            path: src/Mariner/*
        # The Stringable::toUri macro closure is bound to the Stringable it's called on by Macroable, so $this->value() exists at runtime.
        -
            identifier: method.notFound
            message: '#RoutingServiceProvider::value\(\)#'
            path: src/Mariner/Routing/RoutingServiceProvider.php
        # Mailgun and Postmark bridges are suggested packages; MailManager::ensureTransportPackage() fails with an install hint before either is used.
        -
            identifier: class.notFound
            message: '#\bSymfony\\Component\\Mailer\\Bridge\\(Mailgun|Postmark)\\#'
            path: src/Mariner/Mail/MailManager.php
